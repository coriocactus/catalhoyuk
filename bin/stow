#!/usr/bin/env bash
# GNU Stow wrapper. Every directory under stow/ is a package.
set -eu

usage() { printf '%s\n' 'Usage: ./bin/stow [--ssh] [--tmux PROFILE] [--repo4] [--dry-run] [--delete]'; }
error() { printf 'error: %s\n' "$*" >&2; exit 1; }

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
profile=green ssh= repo4= dry= delete=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --ssh) ssh=1 ;;
        --repo4) repo4=1 ;;
        --dry-run) dry=1 ;;
        --delete) delete=1 ;;
        --tmux)
            [ "$#" -ge 2 ] && [ -d "$root/stow/tmux-${2:-}" ] || error "--tmux needs a profile from stow/tmux-*: ${2:-}"
            profile=$2; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

command -v stow >/dev/null 2>&1 || error 'GNU Stow is required: brew install stow'
config=${XDG_CONFIG_HOME:-$HOME/.config}
tmux_profiles=()
for dir in "$root"/stow/tmux-*/; do dir=${dir%/}; tmux_profiles+=("${dir##*/}"); done
run() { stow -d "$root/stow" -v ${dry:+-n} "$@"; }

if [ -n "$delete" ]; then
    run -t "$HOME" -D home agents vim-ssh "${tmux_profiles[@]}"
    run -t "$config" -D xdg
    exit 0
fi

repo4_init=(zsh -f -c 'source "$1" && repo4 init' repo4 "$root/stow/xdg/repo4/repo4.zsh")
if [ -n "$repo4" ]; then
    command -v zsh >/dev/null 2>&1 || error '--repo4 requires zsh'
    REPO4_CHECK_ONLY=1 "${repo4_init[@]}"
fi

# Pi writes sessions under ~/.pi/agent, so link its files individually rather than the directory.
# The extensions directory must fold into one link; a real directory there would be linked file by file.
if [ -d "$HOME/.pi/agent/extensions" ] && [ ! -L "$HOME/.pi/agent/extensions" ]; then
    error "move aside the existing directory: $HOME/.pi/agent/extensions"
fi
[ -n "$dry" ] || mkdir -p "$HOME/.pi/agent" "$config"

run -t "$HOME" --no-folding -R home
if [ -d "$config" ]; then
    run -t "$config" --no-folding --ignore='identities\.example' -R xdg
else
    printf '%s\n' "[dry-run] mkdir $config and stow xdg"
fi
run -t "$HOME" --ignore='skills-lock\.json' \
    -D "${tmux_profiles[@]}" vim-ssh \
    -R agents "tmux-$profile" ${ssh:+vim-ssh}

if [ -n "$repo4" ]; then
    if [ -n "$dry" ]; then printf '%s\n' '[dry-run] repo4 init'; else "${repo4_init[@]}"; fi
fi
