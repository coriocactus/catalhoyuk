{
  "name": "pi-catalhoyuk",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "typecheck": "node test/typecheck.ts",
    "test": "node --test \"*/tests/*.test.ts\" \"test/*.test.ts\"",
    "test:terminal": "node test/e2e/terminal.ts",
    "verify": "npm run check && npm run typecheck && npm test && npm run test:terminal"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
